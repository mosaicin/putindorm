<main class="container py-5">
  <section class="rounded-4 bg-dark text-white p-4 p-lg-5 mb-5 shadow-sm">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <span class="badge bg-light text-dark mb-3">Новый сезон</span>
        <h1 class="display-5 fw-bold mb-3">Удобные вещи для дома, жизни и работы</h1>
        <p class="lead text-white-50 mb-4">Подборка практичных товаров, которые упрощают быт и делают пространство комфортнее.</p>
        <div class="d-flex flex-wrap gap-3">
          <%= link_to "Смотреть каталог", "#products", class: "btn btn-light btn-lg" %>
          <% if admin? %>
            <%= link_to "Добавить товар", new_product_path, class: "btn btn-outline-light btn-lg" %>
          <% end %>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="bg-white text-dark rounded-4 p-4 shadow-sm">
          <p class="text-uppercase text-body-secondary small mb-2">Популярно</p>
          <h2 class="h4 fw-bold mb-3">Порядок, стиль и комфорт</h2>
          <ul class="list-unstyled mb-0">
            <li class="mb-2">✓ Быстрая доставка</li>
            <li class="mb-2">✓ Гарантия качества</li>
            <li>✓ Подбор под ваш интерьер</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="rounded-4 border bg-body-tertiary p-4 p-md-5 mb-5" aria-labelledby="payment-heading">
    <div class="row align-items-center g-4">
      <div class="col-lg">
        <span class="badge bg-primary-subtle text-primary-emphasis mb-2">ЮKassa</span>
        <h2 id="payment-heading" class="h3 mb-2">Удобная онлайн-оплата</h2>
        <p class="text-body-secondary mb-0">Оплата проходит на защищённой странице платёжного сервиса. Доступные способы оплаты будут показаны при оформлении заказа.</p>
      </div>
      <div class="col-lg-auto">
        <%= link_to "Перейти в каталог", "#products", class: "btn btn-outline-primary" %>
      </div>
    </div>
  </section>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h2 class="mb-0">Каталог товаров</h2>
    <% if admin? %>
      <%= link_to "Добавить товар", new_product_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <%= render "calculator/assistant" %>

  <div id="products" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    <% @products.each do |product| %>
      <div class="col">
        <div class="card h-100 border-0 shadow-sm overflow-hidden">
          <img src="<%= product.image_url %>" alt="<%= product.name %>" class="card-img-top object-fit-cover" style="height: 220px;">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
              <span class="badge bg-primary-subtle text-primary-emphasis"><%= product.category %></span>
              <% if product.featured %>
                <span class="badge bg-success-subtle text-success-emphasis">Топ</span>
              <% end %>
            </div>

            <h3 class="h5 card-title">
              <%= link_to product.name, product, class: "link-dark link-underline-opacity-0" %>
            </h3>

            <p class="text-body-secondary flex-grow-1"><%= truncate(product.description, length: 110) %></p>

            <div class="d-flex justify-content-between align-items-center mt-3">
              <span class="fs-5 fw-bold text-dark"><%= number_to_currency(product.price, unit: "₽", separator: ",", format: "%n %u") %></span>
              <div class="d-flex gap-2">
                <%= button_to "В корзину", add_to_cart_path(product), method: :post, class: "btn btn-primary btn-sm" %>
                <%= link_to "Подробнее", product, class: "btn btn-outline-primary btn-sm" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <section class="rounded bg-body-tertiary p-4 p-md-5" aria-labelledby="journey-heading">
    <h2 id="journey-heading" class="mb-2">Journey</h2>
    <p class="text-body-secondary mb-4">Популярные песни группы. Слушайте на официальном YouTube-канале Journey.</p>

    <div class="list-group">
      <% [
        ["Don't Stop Believin'", "Don%27t%20Stop%20Believin"],
        ["Any Way You Want It", "Any%20Way%20You%20Want%20It"],
        ["Faithfully", "Faithfully"],
        ["Lights", "Lights"]
      ].each do |title, query| %>
        <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-3">
          <span class="fw-semibold"><%= title %></span>
          <%= link_to "Слушать на YouTube", "https://www.youtube.com/@journey/search?query=#{query}", class: "btn btn-outline-primary btn-sm", target: "_blank", rel: "noopener noreferrer" %>
        </div>
      <% end %>
    </div>
  </section>
</main>
