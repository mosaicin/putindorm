<main class="container py-5">
  <div class="card border-0 shadow-sm p-4">
    <h1 class="mb-3">Заказ #<%= @order.id %></h1>
    <p>
      <strong>Статус оплаты:</strong>
      <% if @order.payment_status == "succeeded" %>
        Оплачен
      <% elsif @order.payment_status == "canceled" %>
        Отменён
      <% else %>
        Ожидает оплаты
      <% end %>
    </p>

    <h2 class="h5 mt-3">Состав заказа</h2>
    <ul class="list-group list-group-flush mb-4">
      <% @order.order_items.includes(:product).each do |item| %>
        <li class="list-group-item d-flex justify-content-between gap-3 px-0">
          <span><%= item.product.name %> × <%= item.quantity %></span>
          <span><%= number_to_currency(item.unit_price * item.quantity, unit: "₽", separator: ",", format: "%n %u") %></span>
        </li>
      <% end %>
    </ul>

    <p class="fw-bold mb-4">Итого: <%= number_to_currency(@order.total, unit: "₽", separator: ",", format: "%n %u") %></p>

    <% if @order.payment_status != "succeeded" %>
      <%= button_to "Оплатить через ЮKassa", pay_order_path(@order), method: :post, class: "btn btn-primary align-self-start" %>
      <p class="small text-body-secondary mt-3 mb-0">Статус обновится после подтверждения платежа.</p>
    <% else %>
      <%= link_to "Вернуться в магазин", root_path, class: "btn btn-outline-primary align-self-start" %>
    <% end %>
  </div>
</main>
