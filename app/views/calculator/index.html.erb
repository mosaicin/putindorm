<h1>Калькулятор через ИИ</h1>

<div>
  <textarea id="prompt" rows="4" style="width:100%"><%= @prompt %></textarea>
  <br>
  <button id="ask-btn">✨ Сгенерировать через ИИ</button>
  <span id="status"></span>
</div>

<hr>

<pre id="answer" style="background:#f4f4f4; padding:1em; white-space:pre-wrap;"></pre>

<script>
  const btn = document.getElementById("ask-btn");
  const status = document.getElementById("status");
  const answer = document.getElementById("answer");

  btn.addEventListener("click", async () => {
    const prompt = document.getElementById("prompt").value.trim();
    if (!prompt) { status.textContent = "Введите промпт"; return; }

    btn.disabled = true;
    status.textContent = "Генерация...";
    answer.textContent = "";

    try {
      const res = await fetch("/calculator/ask", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector("meta[name=csrf-token]")?.content
        },
        body: JSON.stringify({ prompt })
      });
      const data = await res.json();
      if (data.answer) {
        answer.textContent = data.answer;
        status.textContent = "Готово ✅";
      } else {
        status.textContent = data.error || "Ошибка";
      }
    } catch (e) {
      status.textContent = "Ошибка сети";
    } finally {
      btn.disabled = false;
    }
  });
</script>
